# SkyRadar Environment Configuration

# Backend Port (default 3001)
PORT=3001
NODE_ENV=development

# Optional Cesium Ion Token
# If not provided, SkyRadar uses NASA GIBS Blue Marble & CartoDB zero-cost layers
VITE_CESIUM_ION_TOKEN=

# External ADS-B Providers (All Optional)
# OpenSky Network (Research tier OAuth2 client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# adsb.lol (Optional ad-hoc or feeder API key)
ADSB_LOL_API_KEY=
